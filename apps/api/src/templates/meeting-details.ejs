<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <style>
        body { 
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; 
            color: #0a0a0a; 
            line-height: 1.5; 
            margin: 0; 
            padding: 0;
            background-color: #f8f8f8;
        }
        .wrapper {
            background-color: #f8f8f8;
            padding: 40px 20px;
        }
        .container { 
            max-width: 500px; 
            margin: 0 auto; 
            background: #ffffff;
            border: 1px solid #e5e5e5;
            padding: 60px;
        }
        .logo {
            background: #0a0a0a;
            color: #ffffff;
            width: 32px;
            height: 32px;
            text-align: center;
            line-height: 32px;
            font-weight: bold;
            font-size: 18px;
            margin-bottom: 40px;
        }
        h1 { 
            font-size: 24px; 
            font-weight: 800; 
            text-transform: uppercase; 
            letter-spacing: -0.02em;
            margin: 0 0 40px 0;
            line-height: 1;
        }
        .label {
            font-size: 10px;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 0.2em;
            color: #737373;
            margin-bottom: 8px;
            display: block;
        }
        .value {
            font-size: 14px;
            font-weight: 500;
            margin-bottom: 32px;
        }
        p { margin: 0 0 24px 0; font-size: 14px; }
        .button { 
            display: block; 
            padding: 16px; 
            background: #0a0a0a; 
            color: #ffffff !important; 
            text-decoration: none; 
            text-align: center;
            font-size: 11px;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 0.3em;
            margin-top: 40px;
        }
        .footer { 
            margin-top: 60px; 
            padding-top: 32px;
            border-top: 1px solid #f0f0f0;
            font-size: 10px; 
            color: #a3a3a3; 
            text-transform: uppercase;
            letter-spacing: 0.1em;
        }
        .highlight { color: #6ABAE9; font-weight: bold; }
    </style>
</head>
<body>
    <div class="wrapper">
        <div class="container">
            <div class="logo">S</div>
            <h1>Session Confirmation</h1>
            
            <p>Hello <%= locals.name %>,</p>
            <p>Your expertise session with <span class="highlight">Stable Partners Group</span> has been officially confirmed and integrated into our protocol.</p>
            
            <div style="margin-top: 40px;">
                <span class="label">Scheduled Timestamp</span>
                <div class="value"><%= locals.date %></div>
                
                <span class="label">Access Link</span>
                <div class="value" style="word-break: break-all;"><%= locals.link %></div>
            </div>

            <a href="<%= locals.link %>" class="button">Join Google Meet</a>

            <p style="margin-top: 40px; font-size: 12px; color: #737373;">
                We look forward to optimizing your property portfolio performance.
            </p>

            <div class="footer">
                &copy; 2026 STABLE PARTNERS GROUP
            </div>
        </div>
    </div>
</body>
</html>
