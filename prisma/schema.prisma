// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  password         String
  name             String?
  role             UserRole  @default(ADMIN)
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  bookings         Booking[] // Relation to Bookings
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model AvailabilitySlot {
  id        String   @id @default(uuid())
  startTime DateTime
  endTime   DateTime
  isBooked  Boolean  @default(false)
  booking   Booking?
  createdAt DateTime @default(now())
}

model AvailabilityTemplate {
  id              String   @id @default(uuid())
  dayOfWeek       Int      // 0 (Sunday) to 6 (Saturday)
  startTime       String   // e.g. "09:00"
  endTime         String   // e.g. "17:00"
  timezone        String   // e.g. "America/New_York"
  duration        Int      // Session duration in minutes
  buffer          Int      // Buffer between sessions in minutes
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AvailabilityOverride {
  id            String   @id @default(uuid())
  date          DateTime // Date of override (e.g. 2026-05-25)
  isUnavailable Boolean  @default(false)
  startTime     String?  // Custom start time e.g. "10:00" (null if unavailable)
  endTime       String?  // Custom end time e.g. "14:00" (null if unavailable)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum SessionStatus {
  OPEN
  BOOKED
  CANCELLED
}

model Session {
  id        String        @id @default(uuid())
  date      DateTime      // Date of the slot
  startTime DateTime      // Start time in UTC
  endTime   DateTime      // End time in UTC
  status    SessionStatus @default(OPEN)
  booking   Booking?      // One-to-one relation to booking
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Booking {
  id            String        @id @default(uuid())
  customerName  String
  customerEmail String
  customerPhone String?
  
  // Time & Zone
  timezone      String        @default("UTC")
  slotId        String?       @unique
  slot          AvailabilitySlot? @relation(fields: [slotId], references: [id])
  
  // Session Booking fields
  sessionId     String?       @unique
  session       Session?      @relation(fields: [sessionId], references: [id])
  userId        String?
  user          User?         @relation(fields: [userId], references: [id])
  notes         String?
  
  // Detailed Property Assessment Fields
  propertyType     String?
  propertyLocation String?
  unitsRooms       String?
  occupancyStatus  String?
  estimatedIncome  String?
  mainChallenge    String?
  mainGoal         String?
  additionalInfo   String?
  
  serviceType   String
  description   String?
  status        BookingStatus @default(PENDING)
  meetingDate   DateTime?
  meetingLink   String?
  messages      Message[]
  propertyId    String?
  property      Property?     @relation(fields: [propertyId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Message {
  id        String   @id @default(uuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id])
  sender    String   // 'ADMIN' or 'CUSTOMER'
  content   String
  createdAt DateTime @default(now())
}

model LandingPageContent {
  id        String   @id @default(uuid())
  section   String   @unique // e.g., 'HERO', 'SERVICES'
  title     String
  subtitle  String?
  content   Json?    // For flexible content structure
  imageUrl  String?
  updatedAt DateTime @updatedAt
}

model Property {
  id          String   @id @default(uuid())
  title       String
  description String
  location    String
  price       Float?
  bedrooms    Int?     @default(0)
  bathrooms   Int?     @default(0)
  images      String[] // URLs to images
  videoUrl    String?  // URL to video
  status      String   @default("MANAGED") // e.g., 'MANAGED', 'AVAILABLE', 'SOLD'
  bookings    Booking[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

